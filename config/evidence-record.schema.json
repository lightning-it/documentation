{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.l-it.io/schemas/evidence-record-1.0.json",
  "title": "Public evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "record_version",
    "category",
    "status",
    "title",
    "subject",
    "scope",
    "source",
    "method",
    "observed_at",
    "result",
    "relationships",
    "limitations",
    "owner",
    "review",
    "retention"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "record_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "category": { "type": "string" },
    "status": { "type": "string" },
    "title": { "type": "string", "minLength": 8 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identifier"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["products", "components", "product_versions", "environment"],
      "properties": {
        "products": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "components": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "product_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "environment": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9.-]+$"
        },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "version", "acceptance_rule"],
      "properties": {
        "identifier": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "version": { "type": "string" },
        "acceptance_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier", "version"],
          "properties": {
            "identifier": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "version": { "type": "string" }
          }
        }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "measurements"],
      "properties": {
        "summary": { "type": "string", "minLength": 8 },
        "measurements": { "type": "object" },
        "reason_category": { "type": "string" }
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports_claims", "issues", "pull_requests", "supersedes"],
      "properties": {
        "supports_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" }
        },
        "issues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://github.com/[a-z0-9-]+/[a-z0-9.-]+/issues/[0-9]+$"
          }
        },
        "pull_requests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://github.com/[a-z0-9-]+/[a-z0-9.-]+/pull/[0-9]+$"
          }
        },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ev-[a-z0-9-]+@[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8 }
    },
    "owner": { "type": "string", "minLength": 3 },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_at", "reviewer_role"],
      "properties": {
        "status": { "enum": ["approved", "pending", "rejected"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "reviewer_role": { "type": "string" }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "review_at", "tombstone"],
      "properties": {
        "class": { "type": "string" },
        "review_at": { "type": "string", "format": "date" },
        "tombstone": { "type": "boolean" }
      }
    }
  }
}
