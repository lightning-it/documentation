{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.l-it.io/schema/document-metadata.json",
  "title": "Lightning IT public document metadata",
  "type": "object",
  "required": ["id", "title", "description", "document"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "slug": {
      "type": "string",
      "pattern": "^/"
    },
    "document": {
      "type": "object",
      "required": [
        "status",
        "version",
        "classification",
        "approval_status",
        "owner",
        "approver",
        "audience",
        "last_reviewed",
        "review_cadence"
      ],
      "properties": {
        "status": {
          "enum": [
            "review-candidate",
            "maintained",
            "experimental",
            "deprecated"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "classification": {
          "const": "PUBLIC"
        },
        "approval_status": {
          "enum": ["pending", "approved"]
        },
        "owner": {
          "type": "string",
          "minLength": 3
        },
        "approver": {
          "type": "string",
          "minLength": 3
        },
        "audience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "last_reviewed": {
          "type": "string",
          "format": "date"
        },
        "review_cadence": {
          "enum": ["quarterly", "semiannual", "annual"]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
