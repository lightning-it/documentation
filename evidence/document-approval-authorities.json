{
  "schema_version": 2,
  "single_maintainer_exception": {
    "status": "AUTHORIZED",
    "github_reviewer": "@litroc",
    "required_controls": [
      "exact-current-revision-copilot-review",
      "all-review-findings-resolved",
      "all-required-checks-successful",
      "exact-documentation-tree-digest-evidence"
    ],
    "excluded_decisions": [
      "legal-approval",
      "risk-acceptance",
      "certification-authority",
      "protected-material-publication"
    ]
  },
  "role_authorizations": [
    {
      "approver_role": "Lightning IT Product Owners",
      "github_reviewers": [
        "@lightning-it/lightning-it-product-owners",
        "@litdeg",
        "@litroc"
      ]
    },
    {
      "approver_role": "Lightning IT Security and Compliance Maintainers",
      "github_reviewers": [
        "@lightning-it/lightning-it-security-and-compliance-maintainers",
        "@litdeg",
        "@litroc"
      ]
    }
  ],
  "status": "AUTHORIZED"
}
